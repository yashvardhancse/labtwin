<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>labtwin_sim</name>
  <version>0.1.0</version>
  <description>
    Deterministic simulation of a nanolitre sample-prep robot, publishing ROS 2
    topics and writing MCAP recordings that interoperate with the LabTwin web twin.
  </description>
  <maintainer email="noreply@example.com">LabTwin contributors</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>labtwin_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
